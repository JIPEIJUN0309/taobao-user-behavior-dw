# 进容器的文件必须是 LF：
#   *.sh  —— CRLF 会让 shebang 变成 "#!/usr/bin/env bash\r"，报 bad interpreter
#   *.env —— compose 的 env_file 可能把 \r 带进变量值，写进 core-site.xml 就是坏值
#   *.yml / *.sql —— 统一，避免 diff 噪音
*.sh   text eol=lf
*.env  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf

# 批处理必须是 CRLF，LF 会让某些 CMD 版本解析 goto/label 出错
*.cmd  text eol=crlf
*.bat  text eol=crlf
